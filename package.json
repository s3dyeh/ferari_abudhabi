{
  "name": "animator",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node scripts/verify-seo.mjs && node scripts/compress-build.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "verify:seo": "node scripts/verify-seo.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "^21.0.3",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.0.3",
    "@angular/compiler": "^21.0.3",
    "@angular/core": "^21.0.3",
    "@angular/forms": "^21.0.3",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.0.3",
    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "rxjs": "^7.8.1",
    "simple-icons": "^16.35.0",
    "three": "^0.182.0",
    "tslib": "^2.5.0",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.2",
    "@angular/cli": "^21.0.2",
    "@angular/compiler-cli": "^21.0.3",
    "@types/three": "^0.182.0",
    "jsdom": "^27.1.0",
    "ng-packagr": "^21.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
